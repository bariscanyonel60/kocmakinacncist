# Canlı alan adı. Canonical, Open Graph ve sitemap bu adresi kullanır.
NEXT_PUBLIC_SITE_URL=https://www.ornek-alanadi.com

# Cloudinary. Gizli anahtar yalnızca sunucuda ve yükleme betiğinde kullanılır.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Hosting üzerindeki medya API'si (hosting/koc-api). Token config.php ile aynı olmalı.
MEDIA_API_URL=
MEDIA_API_TOKEN=

# Teklif formu e-postası (Resend). QUOTE_TO_EMAIL boşsa form talebi kabul etmez.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=KOC Makina Web <teklif@kocmakinacnc.com>
QUOTE_TO_EMAIL=

# Tarayıcıya açık değerler. Gizli anahtar buraya yazılmaz.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_FOLDER=koc-makina
